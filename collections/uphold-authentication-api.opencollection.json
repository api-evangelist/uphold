{
  "opencollection": "1.0.0",
  "info": {
    "name": "Core Authentication API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/core/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Request OAuth2 token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.enterprise.sandbox.uphold.com/core/oauth2/token",
            "headers": [
              {
                "name": "Authorization",
                "value": ""
              }
            ],
            "body": {
              "type": "form-urlencoded",
              "data": []
            }
          },
          "docs": "Request an access token using OAuth2 protocol."
        }
      ]
    }
  ],
  "bundled": true
}