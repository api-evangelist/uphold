{
  "opencollection": "1.0.0",
  "info": {
    "name": "Core Webhooks API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/core/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Webhooks",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Request webhook management link",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.enterprise.sandbox.uphold.com/core/webhooks/management-link",
            "headers": [
              {
                "name": "X-Uphold-User-Ip",
                "value": ""
              },
              {
                "name": "X-Uphold-User-Agent",
                "value": ""
              },
              {
                "name": "X-Uphold-User-Origin",
                "value": ""
              },
              {
                "name": "X-Uphold-User-Country",
                "value": ""
              },
              {
                "name": "X-Uphold-User-Subdivision",
                "value": ""
              },
              {
                "name": "X-Uphold-User-City",
                "value": ""
              }
            ],
            "auth": {
              "type": "oauth2",
              "flow": "client_credentials",
              "accessTokenUrl": "/core/oauth2/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Request a webhook management link to configure webhooks."
        }
      ]
    }
  ],
  "bundled": true
}