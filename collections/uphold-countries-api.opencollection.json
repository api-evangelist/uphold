{
  "opencollection": "1.0.0",
  "info": {
    "name": "Core Countries API",
    "version": "0.1.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "/core/oauth2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Countries",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List countries",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.enterprise.sandbox.uphold.com/core/countries",
            "headers": [
              {
                "name": "X-Uphold-User-Ip",
                "value": ""
              },
              {
                "name": "X-Uphold-User-Agent",
                "value": ""
              },
              {
                "name": "X-Uphold-User-Origin",
                "value": ""
              },
              {
                "name": "X-Uphold-User-Country",
                "value": ""
              },
              {
                "name": "X-Uphold-User-Subdivision",
                "value": ""
              },
              {
                "name": "X-Uphold-User-City",
                "value": ""
              }
            ]
          },
          "docs": "List countries supported by the platform."
        },
        {
          "info": {
            "name": "Get country",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.enterprise.sandbox.uphold.com/core/countries/:country",
            "headers": [
              {
                "name": "X-Uphold-User-Ip",
                "value": ""
              },
              {
                "name": "X-Uphold-User-Agent",
                "value": ""
              },
              {
                "name": "X-Uphold-User-Origin",
                "value": ""
              },
              {
                "name": "X-Uphold-User-Country",
                "value": ""
              },
              {
                "name": "X-Uphold-User-Subdivision",
                "value": ""
              },
              {
                "name": "X-Uphold-User-City",
                "value": ""
              }
            ],
            "params": [
              {
                "name": "country",
                "value": "",
                "type": "path",
                "description": "The unique code of the country."
              }
            ]
          },
          "docs": "Retrieve a country by code."
        }
      ]
    }
  ],
  "bundled": true
}